# Copy to .env.local for local work, or run `vercel env pull .env.local`.
# Added automatically when you connect Neon in Vercel → Storage. Use the pooled connection string.
DATABASE_URL=
# Any random string of 32+ characters. Lets the admin refresh cached pages the moment you save.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ISR_BYPASS_TOKEN=
# Emails website consultation requests to the office. Use a send-only key from resend.com/api-keys.
RESEND_API_KEY=
# Optional. Defaults to edu@mountbell.com. Separate several addresses with commas.
LEAD_TO=
# Optional. Must be on a domain verified in Resend. Defaults to Mount Bell Website <website@mountbell.com>.
LEAD_FROM=
