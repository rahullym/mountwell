---
import Icon from './Icon.astro';
import { site, countries, professionGroups, services, nav } from '../data/site';
---
<div class="topbar">
  <div class="wrap">
    <p>Not sure which country you qualify for? <span>A free assessment gives you a shortlist that fits your profile.</span></p>
    <a class="topbar-cta" href="/#eligibility" aria-haspopup="dialog" data-open-eligibility>Free eligibility check <Icon name="arrow" size={15} /></a>
  </div>
</div>

<header class="header" data-header>
  <div class="wrap">
    <a class="brand" href="/" aria-label="Mount Bell home">
      <img src="/logo.png" alt="Mount Bell Global Studies" width="570" height="240" />
    </a>

    <nav aria-label="Main">
      <ul class="nav">
        <li class="has-drop">
          <button class="nav-link" aria-expanded="false" aria-controls="drop-about">About <Icon name="chevron" size={14} /></button>
          <div class="drop" id="drop-about">
            {nav.about.map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
        </li>
        <li class="has-drop">
          <button class="nav-link" aria-expanded="false" aria-controls="drop-services">Services <Icon name="chevron" size={14} /></button>
          <div class="drop" id="drop-services">
            {services.map((s) => <a href={s.href}>{s.name}</a>)}
          </div>
        </li>
        <li>
          <button class="nav-link" aria-expanded="false" aria-controls="panel-countries">Countries <Icon name="chevron" size={14} /></button>
          <div class="panel" id="panel-countries">
            <div class="wrap">
              <div class="mega">
                {countries.map((c) => (
                  <div>
                    <p class="mega-h"><a href={c.href}>{c.name}</a> <span class="mono">{c.code}</span></p>
                    <ul>{c.programmes.map((p) => <li><a href={p.href}>{p.label}</a></li>)}</ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </li>
        <li>
          <button class="nav-link" aria-expanded="false" aria-controls="panel-jobs">Jobs by Profession <Icon name="chevron" size={14} /></button>
          <div class="panel" id="panel-jobs">
            <div class="wrap">
              <div class="mega">
                {professionGroups.map((g) => (
                  <div>
                    <p class="mega-h">{g.name}</p>
                    <ul>{g.links.map((p) => <li><a href={p.href}>{p.label}</a></li>)}</ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </li>
        <li class="has-drop">
          <button class="nav-link" aria-expanded="false" aria-controls="drop-resources">Resources <Icon name="chevron" size={14} /></button>
          <div class="drop" id="drop-resources">
            {nav.resources.map((l) => <a href={l.href}>{l.label}</a>)}
            {nav.tools.map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
        </li>
        <li><a class="nav-link" href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <div class="header-cta">
      <a class="header-phone" href={`tel:${site.phone.tel}`} aria-label={`Call ${site.phone.display}`} title={`Call ${site.phone.display}`}><Icon name="phone" size={18} /></a>
      <button class="icon-btn burger" aria-label="Open menu" aria-expanded="false" aria-controls="drawer" data-open-drawer><Icon name="menu" size={22} /></button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="drawer-head">
    <a class="brand" href="/"><img src="/logo.png" alt="Mount Bell" width="570" height="240" /></a>
    <button class="icon-btn" aria-label="Close menu" data-close-drawer><Icon name="close" size={22} /></button>
  </div>
  <div class="drawer-body">
    <details>
      <summary>Countries <Icon name="chevron" size={18} /></summary>
      <ul>
        {countries.map((c) => (
          <>
            <li class="grp">{c.name}</li>
            <li><a href={c.href}>{c.name} overview</a></li>
            {c.programmes.filter((p) => p.href !== c.href).map((p) => <li><a href={p.href}>{p.label}</a></li>)}
          </>
        ))}
      </ul>
    </details>
    <details>
      <summary>Jobs by Profession <Icon name="chevron" size={18} /></summary>
      <ul>
        {professionGroups.map((g) => (
          <>
            <li class="grp">{g.name}</li>
            {g.links.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
          </>
        ))}
      </ul>
    </details>
    <details>
      <summary>Services <Icon name="chevron" size={18} /></summary>
      <ul>{services.map((s) => <li><a href={s.href}>{s.name}</a></li>)}</ul>
    </details>
    <details>
      <summary>Resources <Icon name="chevron" size={18} /></summary>
      <ul>{[...nav.tools, ...nav.resources].map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </details>
    <details>
      <summary>About <Icon name="chevron" size={18} /></summary>
      <ul>{nav.about.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </details>
    <a href="/contact/">Contact <Icon name="arrow" size={18} /></a>
  </div>
</div>

<script>
  const header = document.querySelector('[data-header]')!;
  const triggers = [...header.querySelectorAll<HTMLButtonElement>('.nav-link[aria-controls]')];
  let closeTimer: number | undefined;

  const closeAll = (except?: HTMLButtonElement) => {
    triggers.forEach((t) => {
      if (t === except) return;
      t.setAttribute('aria-expanded', 'false');
      document.getElementById(t.getAttribute('aria-controls')!)?.classList.remove('is-open');
    });
  };
  const open = (t: HTMLButtonElement) => {
    window.clearTimeout(closeTimer);
    closeAll(t);
    t.setAttribute('aria-expanded', 'true');
    document.getElementById(t.getAttribute('aria-controls')!)?.classList.add('is-open');
  };

  triggers.forEach((t) => {
    const li = t.closest('li')!;
    t.addEventListener('click', () => (t.getAttribute('aria-expanded') === 'true' ? closeAll() : open(t)));
    // Hover opens on pointer devices only; a short delay stops the menu flickering shut.
    li.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && open(t));
    li.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      closeTimer = window.setTimeout(() => closeAll(), 140);
    });
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && (closeAll(), closeDrawer()));
  document.addEventListener('click', (e) => !header.contains(e.target as Node) && closeAll());

  const drawer = document.getElementById('drawer')!;
  const burger = document.querySelector<HTMLButtonElement>('[data-open-drawer]')!;
  function closeDrawer() {
    drawer.classList.remove('is-open');
    burger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  burger.addEventListener('click', () => {
    drawer.classList.add('is-open');
    burger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    drawer.querySelector<HTMLElement>('[data-close-drawer]')?.focus();
  });
  drawer.querySelector('[data-close-drawer]')!.addEventListener('click', () => { closeDrawer(); burger.focus(); });
  drawer.addEventListener('click', (e) => (e.target as HTMLElement).closest('a') && closeDrawer());
</script>
