---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Hero from './Hero.astro';
import FinalCta from './FinalCta.astro';
import { site, countries, goals, professionGroups, professions, services, featured, nursing, exams, steps, reasons, reviews, updates, faqs, waLink, photoAlt, teamPhotos, processPhoto, galleryPhotos } from '../data/site';

const title = 'Immigration Consultancy in Kerala | Mountbell, Thrissur and Kochi';
const description = 'Mountbell is a licensed immigration consultancy in Kerala, with offices in Thrissur and Kochi. Jobs and migration to Australia, Canada, Germany, Malta and more.';
const wa = waLink('Hi Mountbell, I would like to talk to an expert about working or migrating abroad.');
const waCoaching = waLink('Hi Mountbell, I would like to know about IELTS, OET, PTE or German coaching.');
// One accent colour per destination, used by the pathway explorer and the programme cards.
const accent: Record<string, string> = { australia: 'var(--coral)', canada: 'var(--err)', germany: 'var(--amber-deep)', denmark: 'var(--sky)', malta: 'var(--teal)', maldives: 'var(--green-deep)', netherlands: 'var(--blue)', europe: 'var(--plum)' };
const places = countries.map((c) => ({ ...c, slug: c.name.toLowerCase() }));
const byGoal = goals.map((g) => ({ ...g, places: countries.filter((c) => c.goals.includes(g.id)) }));
const jobs = professions.filter((p) => p !== 'Other');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const videoSchema = site.heroVideoId
  ? [{ '@context': 'https://schema.org', '@type': 'VideoObject', name: 'Mountbell: immigration consultants in Kerala', description, thumbnailUrl: `https://i.ytimg.com/vi/${site.heroVideoId}/maxresdefault.jpg`, embedUrl: `https://www.youtube.com/embed/${site.heroVideoId}` }]
  : [];
---
<Base title={title} description={description} schema={[faqSchema, ...videoSchema]}>

  <!-- 02 Hero -->
  <Hero />

  <!-- 03 Trust strip -->
  <section class="trust" aria-label="Why you can trust Mountbell">
    <div class="wrap">
      <ul data-reveal-group>
        <li>
          <strong>MEA licensed recruiting agent</strong>
          <span class="mono">Lic. {site.licence.number}</span>
        </li>
        {site.googleRating && (
          <li>
            <strong>{site.googleRating.score} <span class="stars" aria-hidden="true">★★★★★</span></strong>
            <span>{site.googleRating.count} Google reviews</span>
          </li>
        )}
        {site.foundedYear && <li><strong>{new Date().getFullYear() - site.foundedYear}+ years</strong><span>Guiding Kerala since {site.foundedYear}</span></li>}
        {site.peoplePlaced && <li><strong>{site.peoplePlaced}</strong><span>People placed or migrated</span></li>}
        <li><strong>8 countries</strong><span>20+ job and migration programmes</span></li>
        {!site.googleRating && <li><strong>2 offices</strong><span>Thrissur and Kochi, face to face</span></li>}
        {!site.foundedYear && !site.peoplePlaced && <li><strong>Malayalam · English</strong><span>Free first consultation</span></li>}
      </ul>
    </div>
  </section>

  <!-- 04 Who we are -->
  <section class="section" id="about">
    <div class="wrap who">
      <div class="who-art" data-reveal-group>
        <img class="p1" src={teamPhotos[0].src} alt={teamPhotos[0].alt} width={teamPhotos[0].w} height={teamPhotos[0].h} loading="lazy" decoding="async" />
        <img class="p2" src={teamPhotos[2].src} alt={teamPhotos[2].alt} width={teamPhotos[2].w} height={teamPhotos[2].h} loading="lazy" decoding="async" />
        <img class="p3" src={teamPhotos[1].src} alt={teamPhotos[1].alt} width={teamPhotos[1].w} height={teamPhotos[1].h} loading="lazy" decoding="async" />
        <div class="who-badge">
          <Icon name="shield" size={22} />
          <span><b>MEA licensed recruiting agent</b><span class="mono">{site.licence.number}</span></span>
        </div>
      </div>

      <div class="who-body" data-reveal style="--n:1">
        <h2 class="h2">Mountbell – Trusted Immigration and Overseas Migration Consultants in Thrissur, Kerala</h2>
        <p class="who-lead">Mountbell is a Thrissur-headquartered immigration and migration consultancy that helps professionals from Kerala move to Australia, Canada, Germany, Denmark, Malta, the Maldives, the Netherlands and other European countries through skilled migration, work visa and overseas job programmes.</p>
        <p class="muted">We work as immigration consultants in Thrissur, with a second office in Kochi. People choose us over other overseas immigration consultants in Kerala for a straight answer about what is possible, a named consultant and fees on paper before any payment.</p>
        <dl class="who-facts">
          <div><dt>Head office</dt><dd>Thrissur</dd></div>
          <div><dt>Branch</dt><dd>Kochi</dd></div>
          {site.foundedYear && <div><dt>Founded</dt><dd>{site.foundedYear}</dd></div>}
          {site.founder && <div><dt>{site.founder.role}</dt><dd>{site.founder.name}</dd></div>}
          <div><dt>We speak</dt><dd>Malayalam, English</dd></div>
        </dl>
        <div class="who-links">
          <a class="btn btn-primary btn-sm" href="/about/">About us <Icon name="arrow" size={17} /></a>
          <a class="arrow-link" href="/about/team/">Meet our team <Icon name="arrow" size={17} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Goals -->
  <section class="section section-white" id="goals">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="h2">What Do You Want to Do Abroad?</h2>
        <p class="lede">Four kinds of move, and the countries where Mountbell runs each one.</p>
      </div>
      <div class="goal-grid" data-reveal-group>
        {byGoal.map((g) => (
          <article class={`goal ${g.id}`}>
            <h3><a href={g.href}>{g.label}</a></h3>
            <p>{g.text}</p>
            <ul>{g.places.map((c) => <li>{c.name}</li>)}</ul>
            <span class="go"><Icon name="arrow" size={18} /></span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 Find your pathway -->
  <section class="section" id="pathways">
    <div class="wrap">
      <div class="section-head split" data-reveal>
        <div>
          <h2 class="h2">Find Your Migration Pathway – By Country or By Profession</h2>
          <p class="lede">As overseas job consultants in Kerala, we start with you. Pick a destination or your profession.</p>
        </div>
        <div class="tabs" role="tablist" aria-label="Browse pathways">
          <button role="tab" id="tab-country" aria-selected="true" aria-controls="pane-country">By country</button>
          <button role="tab" id="tab-prof" aria-selected="false" aria-controls="pane-prof" tabindex="-1">By profession</button>
        </div>
      </div>

      <div id="pane-country" role="tabpanel" aria-labelledby="tab-country">
        <div class="pw" data-pw data-reveal>
          <div class="pw-list" role="tablist" aria-label="Destinations" aria-orientation="vertical">
            {places.map((c, i) => (
              <button type="button" role="tab" style={`--c:${accent[c.slug]}`} id={`pw-tab-${i}`} aria-controls={`pw-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                <span>{c.name}</span>
                <em>{c.programmes.length} {c.programmes.length === 1 ? 'programme' : 'programmes'}</em>
              </button>
            ))}
          </div>
          <div class="pw-panels">
            {places.map((c, i) => (
              <article class="pw-panel" style={`--c:${accent[c.slug]}`} id={`pw-${i}`} role="tabpanel" aria-labelledby={`pw-tab-${i}`} hidden={i !== 0}>
                <a class="pw-photo" href={c.href} tabindex="-1">
                  <img src={`/img/dest/${c.slug}-wide.webp`} alt={photoAlt[c.slug]} width="1400" height="820" loading="lazy" decoding="async" />
                  <span class="mono">COK <Icon name="arrow" size={12} /> {c.airport}</span>
                </a>
                <div class="pw-body">
                  <div>
                    <h3>{c.name}</h3>
                    <p>{c.text}</p>
                    <a class="arrow-link" href={c.href}>Explore {c.name} <Icon name="arrow" size={17} /></a>
                  </div>
                  <div class="chips">{c.programmes.map((p) => p.href ? <a class="chip" href={p.href}>{p.label}</a> : <span class="chip">{p.label}</span>)}</div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>

      <div id="pane-prof" role="tabpanel" aria-labelledby="tab-prof" hidden>
        <ul class="prof-grid">
          {professionGroups.map((g) => (
            <li>
              <h3 class="h3">{g.name}</h3>
              <p>{g.text}</p>
              <div class="chips">{g.links.map((p) => p.href ? <a class="chip" href={p.href}>{p.label}</a> : <span class="chip">{p.label}</span>)}</div>
              <a class="arrow-link" href={`/overseas-jobs/#${g.id}`}>Where these jobs are <Icon name="arrow" size={17} /></a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Nursing careers -->
  <section class="section section-white" id="nursing">
    <div class="wrap nurse">
      <div class="nurse-copy" data-reveal>
        <p class="label">Nursing Careers</p>
        <h2 class="h2">Your Nursing Career Starts Here.</h2>
        <p class="lede">Explore trusted international opportunities for nurses and take the next step towards a rewarding global career.</p>
        <div class="nurse-acts">
          <a class="btn btn-primary" href="/free-immigration-assessment/" aria-haspopup="dialog" data-open-eligibility>Book a Free Consultation <Icon name="arrow" size={18} /></a>
          <a class="arrow-link" href="/nursing-careers/">Nursing careers abroad <Icon name="arrow" size={17} /></a>
        </div>
      </div>
      <ul class="nurse-list" data-reveal-group>
        {nursing.map((n) => (
          <li style={`--c:${accent[n.img]}`}>
            <img src={`/img/dest/${n.img}-thumb.webp`} alt="" width="192" height="192" loading="lazy" decoding="async" />
            <div>
              <h3><a href={n.href}>Nurses in {n.place === 'Maldives' ? 'the Maldives' : n.place}</a></h3>
              <p>{n.text}</p>
            </div>
            <span class="go"><Icon name="arrow" size={18} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Professions band -->
  <div class="ticker">
    <p class="vh">Professions we place: {jobs.join(', ')}.</p>
    <div class="ticker-track" aria-hidden="true">
      {[0, 1].map(() => <ul>{jobs.map((p) => <li>{p}</li>)}</ul>)}
    </div>
  </div>

  <!-- 06 Services -->
  <section class="section section-sand" id="services">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="h2">Our Immigration Services in Kerala</h2>
      </div>
      <div class="svc-grid" data-reveal-group>
        {services.map((s) => (
          <article class="svc">
            <h3 class="h3"><a href={s.href}>{s.name}</a></h3>
            <p>{s.text}</p>
            <span class="go"><Icon name="arrow" size={18} /></span>
          </article>
        ))}
      </div>
      <p class="svc-note" data-reveal>Every service includes skills assessment and credential recognition (AHPRA, Anerkennung, Malta registration), IELTS, OET, PTE and German training, documentation, and pre-departure and post-landing support.</p>
    </div>
  </section>

  <!-- Featured programmes -->
  <section class="section section-ink" id="programmes">
    <div class="wrap">
      <div class="section-head split" data-reveal>
        <div>
          <h2 class="h2">Overseas Job and Migration Programmes from Kerala</h2>
          <p class="lede">Six of the programmes our consultants handle from Thrissur and Kochi.</p>
        </div>
        <a class="arrow-link" href="/countries/">Compare all eight countries <Icon name="arrow" size={17} /></a>
      </div>
      <div class="prog-grid" data-reveal-group>
        {featured.map((f, i) => (
          <article class="prog" style={`--c:${accent[f.img]}`}>
            <img src={`/img/dest/${f.img}-${i % 5 === 0 ? 'wide' : 'card'}.webp`} alt={photoAlt[f.img]} width={i % 5 === 0 ? 1400 : 520} height={i % 5 === 0 ? 820 : 650} loading="lazy" decoding="async" />
            <span class="prog-place">{f.place}</span>
            <div class="prog-body">
              <h3><a href={f.href}>{f.title}</a></h3>
              <p>{f.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 07 Eligibility tools -->
  <section class="section" id="tools">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="h2">Check Your Eligibility in 2 Minutes</h2>
        <p class="lede">Two free calculators built on the official points test rules. Not sure which country fits? <a class="tlink" href="/tools/immigration-eligibility-checker/">Try the eligibility calculator</a>.</p>
      </div>
      <div class="tools" data-reveal-group>
        <article class="tool au">
          <img class="tool-bg" src="/img/dest/australia-wide.webp" alt="" width="1400" height="820" loading="lazy" decoding="async" />
          <span class="figure" aria-hidden="true" data-count="65">65</span>
          <span class="label">Australia · skilled migration</span>
          <h3><a href="/tools/australia-pr-points-calculator/">Australia skilled migration points calculator</a></h3>
          <p>Score yourself against the 65-point pass mark for skilled visas.</p>
          <span class="btn btn-light btn-sm">Calculate my points <Icon name="arrow" size={17} /></span>
        </article>
        <article class="tool de">
          <img class="tool-bg" src="/img/dest/germany-wide.webp" alt="" width="1400" height="820" loading="lazy" decoding="async" />
          <span class="figure" aria-hidden="true" data-count="6">6</span>
          <span class="label">Germany · Chancenkarte</span>
          <h3><a href="/tools/opportunity-card-points-calculator/">Germany Opportunity Card points calculator</a></h3>
          <p>See whether you reach the six points needed to job-hunt in Germany.</p>
          <span class="btn btn-light btn-sm">Check my points <Icon name="arrow" size={17} /></span>
        </article>
      </div>
    </div>
  </section>

  <!-- 08 Process -->
  <section class="section section-sky" id="process">
    <div class="wrap proc">
      <figure class="proc-art" data-reveal>
        <img src={processPhoto.src} alt={processPhoto.alt} width={processPhoto.w} height={processPhoto.h} loading="lazy" decoding="async" />
        <figcaption class="mono">Kerala <Icon name="arrow" size={12} /> 8 countries</figcaption>
      </figure>
      <div>
        <div class="section-head" data-reveal>
          <h2 class="h2">How Our Migration Process Works – Step by Step</h2>
        </div>
        <ol class="steps" data-reveal-group>
          {steps.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}
        </ol>
        <p class="svc-note" data-reveal>Timelines depend on the country and programme. You get a written, stage-by-stage estimate with your eligibility report.</p>
      </div>
    </div>
  </section>

  <!-- Language and exam coaching -->
  <section class="section section-teal" id="coaching">
    <div class="wrap coach">
      <div data-reveal>
        <h2 class="h2">IELTS, OET, PTE and German Coaching Alongside Your File</h2>
        <p class="lede">Language preparation is arranged by the same team that handles your paperwork, so the exam and the application move together. We confirm the exact requirement for your country during the free assessment.</p>
        <a class="btn btn-light" href={waCoaching} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> Ask about coaching</a>
      </div>
      <ul class="exams" data-reveal-group>
        {exams.map((e) => <li><strong>{e.name}</strong><span>{e.text}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- 09 Why choose -->
  <section class="section" id="why">
    <div class="wrap why">
      <div class="why-sticky" data-reveal>
        <h2 class="h2">Why Choose Mountbell as Your Overseas Immigration Consultants in Kerala</h2>
        <a class="arrow-link" href="/about/">More about how we work <Icon name="arrow" size={17} /></a>
        <img class="why-photo" src={teamPhotos[3].src} alt={teamPhotos[3].alt} width={teamPhotos[3].w} height={teamPhotos[3].h} loading="lazy" decoding="async" />
      </div>
      <div>
        <ul class="reasons" data-reveal-group>
          {reasons.map((r) => (
            <li><Icon name="check" size={22} /><div><h3>{r.title}</h3><span>{r.text}</span></div></li>
          ))}
        </ul>
        {site.team.length > 0 && (
          <div class="experts" data-reveal>
            <h3 class="h3">Meet Our Experts</h3>
            <ul class="expert-grid">
              {site.team.map((m) => (
                <li class="expert">
                  <img src={m.photo} alt={`${m.name}, ${m.role} at Mountbell`} loading="lazy" width="400" height="500" />
                  <strong>{m.name}</strong>
                  <span>{m.role} · {m.years}</span>
                  <span>{m.credentials}</span>
                  <span>{m.languages}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 10 Licences -->
  <section class="section section-green" id="licence">
    <div class="wrap lic-grid">
      <div data-reveal>
        <h2 class="h2">Licences, Registrations and Partnerships</h2>
        <p class="lede" style="margin-top:18px">Recruiting for overseas jobs from India is legal only with a licence from the Ministry of External Affairs. Search for ours on the government’s eMigrate portal before you trust anyone with your documents.</p>
        <p style="margin-top:20px"><a class="arrow-link" href="/resources/avoid-visa-fraud/">How to identify fake immigration agents <Icon name="arrow" size={17} /></a></p>
      </div>
      <div class="cert" data-reveal style="--n:2">
        <div class="cert-in">
          <div class="cert-top"><Icon name="shield" size={30} /><strong>Government of India<br />Ministry of External Affairs</strong></div>
          <dl>
            <div><dt>Licence type</dt><dd>{site.licence.type}</dd></div>
            <div><dt>Licence no.</dt><dd class="mono"><span data-copy-text>{site.licence.number}</span><button class="copy-btn" type="button" data-copy>Copy</button></dd></div>
            <div><dt>Issued to</dt><dd>{site.legalName}</dd></div>
          </dl>
          <div class="cert-foot">
            <a class="tlink" href={site.licence.verifyUrl} target="_blank" rel="noopener">Verify on eMigrate</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 11 Success stories -->
  <section class="section" id="stories">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="h2">Success Stories – From Kerala to Australia, Germany, Malta and Beyond</h2>
      </div>
      <ul class="snaps" data-reveal-group>
        {galleryPhotos.map((p) => <li><img src={p.src} alt={p.alt} width="480" height="480" loading="lazy" decoding="async" /></li>)}
      </ul>
      <p class="snaps-cap">From the Mountbell gallery.</p>
      <div class="stories" data-reveal-group>
        {reviews.map((r) => (
          <figure class="story" style="margin:0">
            <blockquote>{r.text}</blockquote>
            <figcaption><i aria-hidden="true">{r.name.split(' ').map((w) => w[0]).join('')}</i><div><strong>{r.name}</strong><span>Mountbell client</span></div></figcaption>
          </figure>
        ))}
      </div>
      <div class="stories-foot">
        <a class="arrow-link" href="/success-stories/">Read all success stories <Icon name="arrow" size={17} /></a>
        {site.googleRating && <a class="tlink" href={site.googleRating.url} target="_blank" rel="noopener">{site.googleRating.score} from {site.googleRating.count} Google reviews</a>}
      </div>
    </div>
  </section>

  <!-- 12 Offices -->
  <section class="section section-white" id="offices">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="h2">Immigration Consultants in Thrissur and Kochi – Visit Our Offices</h2>
      </div>
      <div class="offices" data-reveal-group>
        {site.offices.map((o) => (
          <article class="office">
            <iframe title={`Map of Mountbell ${o.city} office`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={`https://www.google.com/maps?q=${encodeURIComponent(o.mapQuery)}&z=15&output=embed`}></iframe>
            <div class="office-body">
              <div class="top"><h3 class="h3" style="font-size:1.6rem">{o.city}</h3><span class="label">{o.label}</span></div>
              <address>{o.lines.map((l) => <>{l}<br /></>)}</address>
              {o.hours && <p class="small muted" style="margin:0">{o.hours}</p>}
              <div class="phones">{o.phones.map((p) => <a href={`tel:${p.tel}`}>{p.display}</a>)}</div>
              <div class="acts">
                <a class="btn btn-ghost btn-sm" href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(o.mapQuery)}`} target="_blank" rel="noopener"><Icon name="pin" size={17} /> Directions</a>
                <a class="btn btn-ghost btn-sm" href={`tel:${o.phones[0].tel}`}><Icon name="phone" size={17} /> Call {o.city}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="svc-note">Our immigration consultants in Thrissur and Kochi serve {site.areasServed.join(', ')} and every other district, with online consultation for people outside Kerala. <a class="tlink" href="/immigration-consultants-thrissur/">More about our Thrissur office</a></p>
    </div>
  </section>

  <!-- 13 Latest updates -->
  <section class="section" id="updates">
    <div class="wrap">
      <div class="section-head split" data-reveal>
        <h2 class="h2">Guides to Read Before You Apply</h2>
        <a class="arrow-link" href="/resources/">All resources <Icon name="arrow" size={17} /></a>
      </div>
      <div class="updates" data-reveal-group>
        {updates.map((u) => (
          <article class="update">
            <img src={`/img/dest/${u.img}-mid.webp`} alt="" width="640" height="440" loading="lazy" decoding="async" />
            <span class="label">{u.tag}</span>
            <h3><a href={u.href}>{u.title}</a></h3>
            <p>{u.excerpt}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 14 FAQ -->
  <section class="section section-white" id="faq">
    <div class="wrap faq-grid">
      <div data-reveal>
        <h2 class="h2">Frequently Asked Questions About Immigration from Kerala</h2>
        <p class="muted" style="margin-top:18px">Something else? <a class="tlink" href={wa} target="_blank" rel="noopener">Ask on WhatsApp</a></p>
      </div>
      <div class="faq" data-reveal>
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary><h3>{f.q}</h3><i aria-hidden="true"></i></summary>
            <div class="ans"><p>{f.a}</p><a class="tlink small" href={f.href}>{f.link}</a></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 15 Final CTA -->
  <FinalCta />
</Base>

<script>
  // Arrow-key and click handling shared by both tab sets.
  function wireTabs(tabs: HTMLButtonElement[], hover = false) {
    const select = (tab: HTMLButtonElement) =>
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      if (hover) t.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && select(t));
      t.addEventListener('keydown', (e) => {
        const step = ['ArrowRight', 'ArrowDown'].includes(e.key) ? 1 : ['ArrowLeft', 'ArrowUp'].includes(e.key) ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        next.focus();
        select(next);
      });
    });
  }
  wireTabs([...document.querySelectorAll<HTMLButtonElement>('.tabs [role="tab"]')]);
  wireTabs([...document.querySelectorAll<HTMLButtonElement>('[data-pw] [role="tab"]')], true);

  // Hero button: scroll to the form at the foot of the page and put the cursor in the first field.
  document.querySelector('[data-focus-form]')?.addEventListener('click', () => {
    setTimeout(() => document.querySelector<HTMLInputElement>('#final-name')?.focus({ preventScroll: true }), 900);
  });

  // Copy licence number
  document.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    await navigator.clipboard.writeText(document.querySelector('[data-copy-text]')!.textContent!.trim());
    btn.textContent = 'Copied';
    setTimeout(() => (btn.textContent = 'Copy'), 1800);
  });
</script>
