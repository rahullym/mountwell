---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Hero from './Hero.astro';
import FinalCta from './FinalCta.astro';
import { getReviews, getFaqs, getUpdateCards } from '../lib/content';
import { photoSrc } from '../lib/photos';
import { site, countries, goals, professionGroups, homeServices, supportChips, nursing, training, steps, reasons, waLink, photoAlt, teamPhotos, processPhoto, nursingPhoto, galleryPhotos } from '../data/site';

const title = 'Immigration Consultancy in Kerala – PR & Visas | Mount Bell';
const description = 'Established in 2017, Mount Bell is an MEA-licensed immigration consultancy for PR, work visas and nursing careers abroad. Main branch in Kochi, Kerala.';
const wa = waLink('Hi Mount Bell, I would like to talk to an expert about working or migrating abroad.');
// One accent colour per destination, used by the pathway explorer and the programme cards.
const accent: Record<string, string> = { australia: 'var(--coral)', canada: 'var(--err)', germany: 'var(--amber-deep)', denmark: 'var(--sky)', malta: 'var(--teal)', maldives: 'var(--green-deep)', netherlands: 'var(--blue)', europe: 'var(--plum)' };
const places = countries.map((c) => ({ ...c, slug: c.name.toLowerCase() }));
const officeName: Record<string, string> = { Kochi: 'Kochi Main Branch', Thrissur: 'Thrissur Branch' };

const [allReviews, faqs, updates] = await Promise.all([getReviews(), getFaqs(), getUpdateCards()]);
const reviews = allReviews.slice(0, 3);
const hasPosts = updates.some((u) => u.href.startsWith('/blog/'));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const videoSchema = site.heroVideoId
  ? [{ '@context': 'https://schema.org', '@type': 'VideoObject', name: 'Mount Bell: immigration consultants in Kerala', description, thumbnailUrl: `https://i.ytimg.com/vi/${site.heroVideoId}/maxresdefault.jpg`, embedUrl: `https://www.youtube.com/embed/${site.heroVideoId}` }]
  : [];
---
<Base title={title} description={description} schema={[faqSchema, ...videoSchema]}>

  <!-- 02 Hero -->
  <Hero />

  <!-- 03 Trust strip -->
  <section class="trust" aria-label="Why you can trust Mount Bell">
    <div class="wrap">
      <ul data-reveal-group>
        {site.foundedYear && <li><strong>Established {site.foundedYear}</strong><span>{new Date().getFullYear() - site.foundedYear} years of visa and recruitment experience</span></li>}
        <li><strong>Check us before you pay</strong><span>Search our licence number on the government’s eMigrate portal, and get every fee in writing first</span></li>
        {site.googleRating && (
          <li>
            <strong>{site.googleRating.score} <span class="stars" aria-hidden="true">★★★★★</span></strong>
            <span>{site.googleRating.count} Google reviews</span>
          </li>
        )}
        {site.peoplePlaced && <li><strong>{site.peoplePlaced}</strong><span>People placed or migrated</span></li>}
        <li><strong>8 countries</strong><span>PR, work visa and overseas job programmes</span></li>
        {!site.googleRating && <li><strong>{site.presence}</strong><span>Main branch in Kochi · Branch in Thrissur</span></li>}
        {!site.foundedYear && !site.peoplePlaced && <li><strong>Malayalam · English</strong><span>Free first consultation</span></li>}
      </ul>
    </div>
  </section>

  <!-- 04 Who we are -->
  <section class="section" id="about">
    <div class="wrap who">
      <div class="who-art" data-reveal-group>
        <img class="p1" src={teamPhotos[0].src} alt={teamPhotos[0].alt} width={teamPhotos[0].w} height={teamPhotos[0].h} loading="lazy" decoding="async" />
        <img class="p2" src={teamPhotos[2].src} alt={teamPhotos[2].alt} width={teamPhotos[2].w} height={teamPhotos[2].h} loading="lazy" decoding="async" />
        <img class="p3" src={teamPhotos[1].src} alt={teamPhotos[1].alt} width={teamPhotos[1].w} height={teamPhotos[1].h} loading="lazy" decoding="async" />
        <div class="who-badge">
          <Icon name="shield" size={22} />
          <span><b>MEA licensed recruiting agent</b><span class="mono">{site.licence.number}</span></span>
        </div>
      </div>

      <div class="who-body" data-reveal style="--n:1">
        <h2 class="h2">Mount Bell – Trusted Immigration and Overseas Migration Consultants, Established in 2017</h2>
        <p class="who-lead">Established in {site.foundedYear}, Mount Bell is an immigration and overseas recruitment consultancy with a presence in {site.presence}. We help professionals move to Australia, Canada, Germany, Denmark, Malta, the Maldives, the Netherlands and other European countries through skilled migration, work visa and overseas job programmes.</p>
        <p class="muted">Our main branch is in Kochi, with a second branch in Thrissur, and we recruit for overseas employers under licence {site.licence.number}, issued to {site.legalName}. Our team specialises in healthcare, skilled trades, IT and teaching.</p>
        <p class="muted">Every client gets a named consultant, a straight answer about what is possible and fees in writing before any payment. That is why families comparing overseas immigration consultants in Kerala recommend us to relatives who want to migrate abroad from Kerala.</p>
        <dl class="who-facts">
          {site.foundedYear && <div><dt>Established</dt><dd>{site.foundedYear}</dd></div>}
          <div><dt>Main branch</dt><dd>Kochi</dd></div>
          <div><dt>Branch</dt><dd>Thrissur</dd></div>
          <div><dt>Presence</dt><dd>{site.presence}</dd></div>
          {site.founder && <div><dt>{site.founder.role}</dt><dd>{site.founder.name}</dd></div>}
          <div><dt>We speak</dt><dd>Malayalam, English</dd></div>
        </dl>
        <div class="who-links">
          <a class="btn btn-primary btn-sm" href="/about-us/">About Us <Icon name="arrow" size={17} /></a>
          <a class="arrow-link" href="/about-us/team/">Meet Our Team <Icon name="arrow" size={17} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Find your pathway -->
  <section class="section" id="pathways">
    <div class="wrap">
      <div class="section-head split" data-reveal>
        <div>
          <h2 class="h2">Find Your Migration Pathway – By Country or By Profession</h2>
          <p class="lede">As overseas job consultants in Kerala, we start with your profile, not with a country we want to sell. Pick a destination or profession, and our overseas career consultants in Kerala show which programmes fit.</p>
          <div class="goal-filter" role="group" aria-label="Filter countries by goal">
            {goals.map((g) => <button type="button" data-goal={g.id} aria-pressed="false">{g.label}</button>)}
          </div>
        </div>
        <div class="tabs" role="tablist" aria-label="Browse pathways">
          <button role="tab" id="tab-country" aria-selected="true" aria-controls="pane-country">By country</button>
          <button role="tab" id="tab-prof" aria-selected="false" aria-controls="pane-prof" tabindex="-1">By profession</button>
        </div>
      </div>

      <div id="pane-country" role="tabpanel" aria-labelledby="tab-country">
        <div class="pw" data-pw data-reveal>
          <div class="pw-list" role="tablist" aria-label="Destinations" aria-orientation="vertical">
            {places.map((c, i) => (
              <button type="button" role="tab" data-goals={c.goals.join(' ')} style={`--c:${accent[c.slug]}`} id={`pw-tab-${i}`} aria-controls={`pw-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                <span>{c.name}</span>
                <em>{c.programmes.length} {c.programmes.length === 1 ? 'programme' : 'programmes'}</em>
              </button>
            ))}
          </div>
          <div class="pw-panels">
            {places.map((c, i) => (
              <article class="pw-panel" style={`--c:${accent[c.slug]}`} id={`pw-${i}`} role="tabpanel" aria-labelledby={`pw-tab-${i}`} hidden={i !== 0}>
                <a class="pw-photo" href={c.href} tabindex="-1">
                  <img src={`/img/dest/${c.slug}-wide.webp`} alt={photoAlt[c.slug]} width="1400" height="820" loading="lazy" decoding="async" />
                  <span class="mono">COK <Icon name="arrow" size={12} /> {c.airport}</span>
                </a>
                <div class="pw-body">
                  <div>
                    <h3>{c.name}</h3>
                    <p>{c.text}</p>
                  </div>
                  <div class="chips">{c.programmes.map((p) => p.href ? <a class="chip" href={p.href}>{p.label}</a> : <span class="chip">{p.label}</span>)}</div>
                  <a class="arrow-link" href={c.href}>Explore {c.name} <Icon name="arrow" size={17} /></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>

      <div id="pane-prof" role="tabpanel" aria-labelledby="tab-prof" hidden>
        <ul class="prof-grid">
          {professionGroups.map((g) => (
            <li>
              <h3 class="h3">{g.name}</h3>
              <p>{g.text}</p>
              <a class="arrow-link" href={`/overseas-jobs/#${g.id}`}>Where these jobs are <Icon name="arrow" size={17} /></a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 05B Nursing careers -->
  <section class="section section-white" id="nursing">
    <div class="wrap nurse">
      <div class="nurse-copy" data-reveal>
        <h2 class="h2"><span>Nursing Careers</span></h2>
        <p class="nurse-sub">Your nursing career starts here.</p>
        <p class="lede">Explore trusted international opportunities for nurses and take the next step towards a rewarding global career.</p>
      </div>
      {nursingPhoto && (
        <figure class="nurse-art" data-reveal>
          <img src={nursingPhoto.src} alt={nursingPhoto.alt} width={nursingPhoto.w} height={nursingPhoto.h} loading="lazy" decoding="async" />
          <figcaption><b>{nursing.length} countries</b><span>{nursing.map((n) => n.place).join(' · ')}</span></figcaption>
        </figure>
      )}
      <ul class="nurse-list" data-reveal-group>
        {nursing.map((n) => (
          <li style={`--c:${accent[n.img]}`}>
            <img src={`/img/dest/${n.img}-thumb.webp`} alt="" width="192" height="192" loading="lazy" decoding="async" />
            <div>
              <h3><a href={n.href}>Nurses in {n.place === 'Maldives' ? 'the Maldives' : n.place}</a></h3>
              <p>{n.text}</p>
            </div>
            <span class="go"><Icon name="arrow" size={18} /></span>
          </li>
        ))}
      </ul>
      <div class="nurse-acts" data-reveal>
        <a class="btn btn-primary" href="/free-immigration-assessment/" aria-haspopup="dialog" data-open-eligibility>Book a Free Consultation <Icon name="arrow" size={18} /></a>
        <a class="arrow-link" href="/nursing-careers/">Nursing Careers Abroad <Icon name="arrow" size={17} /></a>
      </div>
    </div>
  </section>

  <!-- 06 Services -->
  <section class="section section-sand" id="services">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="h2">Our Immigration and Migration Services in Kerala</h2>
      </div>
      <div class="svc-grid eight" data-reveal-group>
        {homeServices.map((s) => (
          <article class="svc">
            <h3 class="h3">{s.href ? <a href={s.href}>{s.name}</a> : s.name}</h3>
            <p>{s.text}</p>
            {s.href && <span class="go"><Icon name="arrow" size={18} /></span>}
          </article>
        ))}
      </div>
      <p class="svc-note" data-reveal>Every service at our immigration consultancy in Kerala includes documentation, pre-departure and post-landing support. Families who need migration consultants in Kerala for a long-term move get one plan covering every visa, not a series of separate fees.</p>
      <div class="chips" style="margin-top:18px" data-reveal>{supportChips.map((c) => <span class="chip">{c}</span>)}</div>
    </div>
  </section>

  <!-- 06B Language training -->
  <section class="section section-white" id="training">
    <div class="wrap train">
      <div class="train-copy" data-reveal>
        <div class="section-head">
          <h2 class="h2">Online Language Training for Work and Migration Abroad</h2>
          <p class="lede">The language exam often decides when you can travel. Mount Bell runs its language training as a dedicated educational service, taught online, so your classes and your application are planned together.</p>
        </div>
        <div class="train-acts">
          <a class="btn btn-primary" href="/training/">Explore Training <Icon name="arrow" size={18} /></a>
          <a class="arrow-link" href={waLink('Hi Mount Bell, I would like to know about your language training courses.')} target="_blank" rel="noopener">Ask About a Course <Icon name="arrow" size={17} /></a>
        </div>
      </div>
      <div data-reveal style="--n:1">
        <div class="train-lead">
          {training.filter((t) => t.native).map((t) => (
            <article>
              <span class="mono">{t.native} · Online</span>
              <h3><a href={`/training/#${t.id}`}>{t.name} Language Training</a></h3>
              <p>{t.text}</p>
              <div class="chips">{t.links!.map((l) => <a class="chip" href={l.href}>{l.label}</a>)}</div>
            </article>
          ))}
        </div>
        <ul class="train-more">
          {training.filter((t) => !t.native).map((t) => (
            <li>
              <h3><a href={`/training/#${t.id}`}>{t.name}</a></h3>
              <p>{t.text}</p>
              <span class="go"><Icon name="arrow" size={18} /></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 07 Eligibility tools -->
  <section class="section" id="tools">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="h2">Check Your Eligibility in 2 Minutes</h2>
        <p class="lede">Free calculators from our immigration consultancy in Kerala, built on the official points test rules. Check Australia’s 65-point pass mark or Germany’s six-point Opportunity Card (Chancenkarte) test, and each result goes to our work abroad consultants in Kerala for a free review.</p>
      </div>
      <div class="tools" data-reveal-group>
        <article class="tool au">
          <img class="tool-bg" src="/img/dest/australia-wide.webp" alt="" width="1400" height="820" loading="lazy" decoding="async" />
          <span class="figure" aria-hidden="true" data-count="65">65</span>
          <span class="label">Australia · skilled migration</span>
          <h3><a href="/tools/australia-pr-points-calculator/">Australia Skilled Migration Points Calculator</a></h3>
          <p>Score yourself against the 65-point pass mark.</p>
          <span class="btn btn-light btn-sm">Calculate My Points <Icon name="arrow" size={17} /></span>
        </article>
        <article class="tool de">
          <img class="tool-bg" src="/img/dest/germany-wide.webp" alt="" width="1400" height="820" loading="lazy" decoding="async" />
          <span class="figure" aria-hidden="true" data-count="6">6</span>
          <span class="label">Germany · Chancenkarte</span>
          <h3><a href="/tools/opportunity-card-points-calculator/">Germany Opportunity Card Points Calculator</a></h3>
          <p>See whether you reach the six points needed to job-hunt in Germany.</p>
          <span class="btn btn-light btn-sm">Check My Points <Icon name="arrow" size={17} /></span>
        </article>
      </div>
      <p class="svc-note" data-reveal>Not sure which country fits? <a class="tlink" href="/tools/immigration-eligibility-checker/">Try the eligibility calculator</a>.</p>
    </div>
  </section>

  <!-- 08 Process -->
  <section class="section section-sky" id="process">
    <div class="wrap proc">
      <figure class="proc-art" data-reveal>
        <img src={processPhoto.src} alt={processPhoto.alt} width={processPhoto.w} height={processPhoto.h} loading="lazy" decoding="async" />
        <figcaption class="mono">India <Icon name="arrow" size={12} /> 8 countries</figcaption>
      </figure>
      <div>
        <div class="section-head" data-reveal>
          <h2 class="h2">How Our Migration Process Works – Step by Step</h2>
        </div>
        <ol class="steps" data-reveal-group>
          {steps.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}
        </ol>
        <p class="svc-note" data-reveal>Timelines depend on the country and programme. Our immigration advisers in Kerala give you a written, stage-by-stage estimate with your eligibility report.</p>
        <p style="margin:18px 0 0" data-reveal><a class="arrow-link" href="/how-it-works/">How It Works <Icon name="arrow" size={17} /></a></p>
      </div>
    </div>
  </section>

  <!-- 09 Why choose -->
  <section class="section" id="why">
    <div class="wrap why">
      <div class="why-sticky" data-reveal>
        <h2 class="h2">Why Choose Mount Bell as Your Immigration Consultancy in Kerala</h2>
        <img class="why-photo" src={teamPhotos[3].src} alt={teamPhotos[3].alt} width={teamPhotos[3].w} height={teamPhotos[3].h} loading="lazy" decoding="async" />
      </div>
      <div>
        <ul class="reasons" data-reveal-group>
          {reasons.slice(0, 5).map((r) => (
            <li><Icon name="check" size={22} /><div><h3>{r.title}</h3><span>{r.text}</span></div></li>
          ))}
        </ul>
        <div class="experts" data-reveal>
          <h3 class="h3">{reasons[5].title}</h3>
          <p class="muted">{reasons[5].text}</p>
        </div>
        <div class="experts" data-reveal>
          <h3 class="h3">Meet Our Experts</h3>
          <p class="muted">Our immigration experts in Kerala each handle named files and speak Malayalam and English. See their roles, years of experience and credentials on the Our Team page.</p>
          {site.team.length > 0 && (
            <ul class="expert-grid">
              {site.team.map((m) => (
                <li class="expert">
                  <img src={m.photo} alt={`${m.name}, ${m.role} at Mount Bell`} loading="lazy" width="400" height="500" />
                  <strong>{m.name}</strong>
                  <span>{m.role} · {m.years}</span>
                  <span>{m.credentials}</span>
                  <span>{m.languages}</span>
                </li>
              ))}
            </ul>
          )}
          <div class="stories-foot" style="justify-content:flex-start">
            <a class="arrow-link" href="/fees/">Fees <Icon name="arrow" size={17} /></a>
            <a class="arrow-link" href="/about-us/team/">Our Team <Icon name="arrow" size={17} /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 10 Licences -->
  <section class="section section-green" id="licence">
    <div class="wrap lic-grid">
      <div data-reveal>
        <h2 class="h2">Licences, Registrations and Partnerships</h2>
        <p class="lede" style="margin-top:18px">Any immigration consultancy in Kerala that recruits for overseas jobs must hold a Recruiting Agent licence from the Ministry of External Affairs (MEA). Our licence number is {site.licence.number}, issued to {site.legalName}, and you can search it on the government’s eMigrate portal before you share a single document. Licensed immigration consultants in Kerala should be happy to show you this. If an agent will not, walk away.</p>
      </div>
      <div data-reveal style="--n:2">
      <div class="cert">
        <div class="cert-in">
          <div class="cert-top"><Icon name="shield" size={30} /><strong>Government of India<br />Ministry of External Affairs</strong></div>
          <dl>
            <div><dt>Licence type</dt><dd>{site.licence.type}</dd></div>
            <div><dt>Licence no.</dt><dd class="mono"><span data-copy-text>{site.licence.number}</span><button class="copy-btn" type="button" data-copy>Copy</button></dd></div>
            <div><dt>Issued to</dt><dd>{site.legalName}</dd></div>
          </dl>
          <div class="cert-foot">
            <a class="tlink" href={site.licence.verifyUrl} target="_blank" rel="noopener">Verify on eMigrate</a>
          </div>
        </div>
      </div>
        <p style="margin:30px 0 0"><a class="arrow-link" href="/resources/avoid-visa-fraud/">How to Identify Fake Immigration Agents <Icon name="arrow" size={17} /></a></p>
      </div>
    </div>
  </section>

  <!-- 11 Success stories -->
  <section class="section" id="stories">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="h2">Success Stories – From Kerala to Australia, Germany, Malta and Beyond</h2>
        <p class="lede">A few words from clients who chose Mount Bell as their trusted immigration consultants in Kerala, from the first consultation to the day they flew.</p>
      </div>
      <div class="stories" data-reveal-group>
        {reviews.map((r) => (
          <figure class="story" style="margin:0">
            <blockquote>{r.text}</blockquote>
            <figcaption><i aria-hidden="true">{r.name.split(' ').map((w) => w[0]).join('').slice(0, 3)}</i><div><strong>{r.name}</strong><span>{r.role}</span></div></figcaption>
          </figure>
        ))}
      </div>
      <div class="stories-foot">
        <a class="arrow-link" href="/success-stories/">Read All Success Stories <Icon name="arrow" size={17} /></a>
        {site.googleRating && <a class="tlink" href={site.googleRating.url} target="_blank" rel="noopener">{site.googleRating.score} from {site.googleRating.count} Google reviews</a>}
      </div>
      <ul class="snaps" style="margin-top:40px" data-reveal-group>
        {galleryPhotos.map((p) => <li><img src={p.src} alt={p.alt} width="480" height="480" loading="lazy" decoding="async" /></li>)}
      </ul>
      <p class="snaps-cap">From the Mount Bell gallery.</p>
    </div>
  </section>

  <!-- 12 Offices -->
  <section class="section section-white" id="offices">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="h2">Visit Our Offices in Kochi and Thrissur</h2>
      </div>
      <div class="offices" data-reveal-group>
        {site.offices.map((o) => (
          <article class="office">
            <iframe title={`Map of Mount Bell ${o.city} office`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={`https://www.google.com/maps?q=${encodeURIComponent(o.mapQuery)}&z=15&output=embed`}></iframe>
            <div class="office-body">
              <div class="top"><h3 class="h3" style="font-size:1.6rem">{officeName[o.city]}</h3></div>
              <address>{o.lines.map((l) => <>{l}<br /></>)}</address>
              {o.hours && <p class="small muted" style="margin:0">{o.hours}</p>}
              <div class="phones">{o.phones.map((p) => <a href={`tel:${p.tel}`}>{p.display}</a>)}</div>
              <div class="acts">
                <a class="btn btn-ghost btn-sm" href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(o.mapQuery)}`} target="_blank" rel="noopener"><Icon name="pin" size={17} /> Directions</a>
                <a class="btn btn-ghost btn-sm" href={`tel:${o.phones[0].tel}`}><Icon name="phone" size={17} /> Call {o.city}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="svc-note">Kochi is our main branch, and both offices are run by the same team. We meet clients from every district of Kerala, including {site.areasServed.slice(0, -1).join(', ')} and {site.areasServed.at(-1)}, and work with people across India and abroad by phone and video call.</p>
      <p class="svc-note" style="margin-top:12px"><a class="tlink" href="/immigration-consultants-kochi/">Mount Bell Kochi office</a> &nbsp;·&nbsp; <a class="tlink" href="/immigration-consultants-thrissur/">Mount Bell Thrissur office</a></p>
    </div>
  </section>

  <!-- 13 Latest updates -->
  <section class="section" id="updates">
    <div class="wrap">
      <div class="section-head split" data-reveal>
        <div>
          <h2 class="h2">Latest Visa, Migration and Overseas Job Updates</h2>
          <p class="lede">Visa rules change often, so our immigration consultancy in Kerala publishes dated guides you can read before you apply.</p>
        </div>
      </div>
      <div class="updates" data-reveal-group>
        {updates.map((u) => (
          <article class="update">
            <img src={photoSrc(u.img, 'mid')} alt="" width="640" height="440" loading="lazy" decoding="async" />
            <span class="label">{u.tag}</span>
            <h3><a href={u.href}>{u.title}</a></h3>
            <p>{u.excerpt}</p>
          </article>
        ))}
      </div>
      <p style="margin:32px 0 0">{hasPosts
        ? <a class="arrow-link" href="/blog/">All Updates <Icon name="arrow" size={17} /></a>
        : <a class="arrow-link" href="/resources/">All Resources <Icon name="arrow" size={17} /></a>}</p>
    </div>
  </section>

  <!-- 14 FAQ -->
  <section class="section section-white" id="faq">
    <div class="wrap faq-grid">
      <div data-reveal>
        <h2 class="h2">Frequently Asked Questions About Immigration from Kerala</h2>
        <p class="muted" style="margin-top:18px">Something else? <a class="tlink" href={wa} target="_blank" rel="noopener">Ask on WhatsApp</a></p>
      </div>
      <div class="faq" data-reveal>
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary><h3>{f.q}</h3><i aria-hidden="true"></i></summary>
            <div class="ans"><p>{f.a}</p>{f.href && <a class="tlink small" href={f.href}>{f.link}</a>}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 15 Final CTA -->
  <FinalCta heading="Book Your Free Migration Eligibility Assessment Today" text={`Speak to Mount Bell, a licensed immigration consultancy in Kerala, in person, by phone or on WhatsApp. Call ${site.phone.display}, visit our Kochi or Thrissur office, or fill in the short form and a consultant will contact you.`} submit="Book My Free Assessment" />
</Base>

<script>
  // Arrow-key and click handling shared by both tab sets.
  function wireTabs(tabs: HTMLButtonElement[], hover = false) {
    const select = (tab: HTMLButtonElement) =>
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      if (hover) t.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && select(t));
      t.addEventListener('keydown', (e) => {
        const step = ['ArrowRight', 'ArrowDown'].includes(e.key) ? 1 : ['ArrowLeft', 'ArrowUp'].includes(e.key) ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        next.focus();
        select(next);
      });
    });
  }
  wireTabs([...document.querySelectorAll<HTMLButtonElement>('.tabs [role="tab"]')]);
  wireTabs([...document.querySelectorAll<HTMLButtonElement>('[data-pw] [role="tab"]')], true);

  // Goal chips narrow the country list. Pressing the active chip again shows every country.
  const goalChips = [...document.querySelectorAll<HTMLButtonElement>('.goal-filter [data-goal]')];
  const countryTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-pw] [role="tab"]')];
  goalChips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const on = chip.getAttribute('aria-pressed') !== 'true';
      goalChips.forEach((c) => c.setAttribute('aria-pressed', String(on && c === chip)));
      countryTabs.forEach((t) => (t.hidden = on && !t.dataset.goals!.split(' ').includes(chip.dataset.goal!)));
      document.getElementById('tab-country')!.click();
      const shown = countryTabs.filter((t) => !t.hidden);
      if (!shown.some((t) => t.getAttribute('aria-selected') === 'true')) shown[0]?.click();
    }),
  );

  // Hero button: scroll to the form at the foot of the page and put the cursor in the first field.
  document.querySelector('[data-focus-form]')?.addEventListener('click', () => {
    setTimeout(() => document.querySelector<HTMLInputElement>('#final-name')?.focus({ preventScroll: true }), 900);
  });

  // Copy licence number
  document.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    await navigator.clipboard.writeText(document.querySelector('[data-copy-text]')!.textContent!.trim());
    btn.textContent = 'Copied';
    setTimeout(() => (btn.textContent = 'Copy'), 1800);
  });
</script>
