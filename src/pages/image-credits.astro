---
import Base from '../layouts/Base.astro';
import credits from '../data/image-credits.json';
const place: Record<string, string> = { hero: 'Homepage banner (Kochi)', kerala: 'Kerala', maldives: 'Maldives', malta: 'Malta', europe: 'Europe (Riga)', germany: 'Germany', netherlands: 'Netherlands', denmark: 'Denmark', canada: 'Canada', australia: 'Australia', nursing: 'Nursing Careers (Kerala)' };
---
<Base title="Image credits | Mountbell" description="Sources and licences for the photographs used on the Mountbell website.">
  <div class="wrap">
    <header class="page-head">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Image credits</span></nav>
      <h1 class="display">Image credits</h1>
      <p class="lede" style="margin-top:18px;max-width:640px">Destination photographs on this site come from Wikimedia Commons and are used under Creative Commons licences. The Nursing Careers photograph comes from Pexels. Each has been cropped and resized. Team and gallery photographs belong to Mountbell.</p>
    </header>
    <div class="prose" style="max-width:860px">
      <ul style="list-style:none;padding:0;gap:0">
        {credits.map((c) => (
          <li style="padding:14px 0;border-bottom:1px solid var(--line)">
            <strong style="color:var(--ink)">{place[c.slug]}</strong> · “<a class="tlink" href={c.source} rel="noopener">{c.title}</a>” by {c.author},
            licensed under <a class="tlink" href={c.licenceUrl} rel="noopener license">{c.licence}</a>. Cropped.
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>
