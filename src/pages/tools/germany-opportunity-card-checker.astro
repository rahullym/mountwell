---
import Base from '../../layouts/Base.astro';
import PointsTool from '../../components/PointsTool.astro';
import { site } from '../../data/site';

const title = 'Germany Opportunity Card Points Checker (Chancenkarte) | Mount Bell';
const description = 'Free Germany Opportunity Card points checker. See whether you reach the six points needed for the Chancenkarte job seeker visa from India.';

const questions = [
  { id: 'baseline', type: 'check', title: 'Basic requirements', hint: 'All three are needed before points are counted.', options: [
    { label: 'A degree, or a vocational qualification of at least 2 years, recognised in the country where I earned it', points: 0, checked: true },
    { label: 'German at A1 level or English at B2 level', points: 0, checked: true },
    { label: 'I can show funds for my stay (blocked account or part-time job contract)', points: 0, checked: true },
  ] },
  { id: 'recognition', title: 'Recognition of your qualification in Germany', options: [
    { label: 'Not assessed yet, or not recognised', points: 0, checked: true },
    { label: 'Partially recognised', points: 4 },
    { label: 'Fully recognised', points: 0, flag: 'full' },
  ] },
  { id: 'experience', title: 'Work experience in your qualified profession', options: [
    { label: 'Under 2 years', points: 0, checked: true },
    { label: '2 years in the last 5', points: 2 },
    { label: '5 years in the last 7', points: 3 },
  ] },
  { id: 'german', title: 'German language level', options: [
    { label: 'None or A1', points: 0, checked: true }, { label: 'A2', points: 1 }, { label: 'B1', points: 2 }, { label: 'B2 or higher', points: 3 },
  ] },
  { id: 'age', title: 'Your age', options: [
    { label: 'Under 35', points: 2, checked: true }, { label: '35–40', points: 1 }, { label: 'Over 40', points: 0 },
  ] },
  { id: 'extras', type: 'check', title: 'Tick any that apply', options: [
    { label: 'English at C1 level or native speaker', points: 1 },
    { label: 'My profession is a shortage occupation in Germany', points: 1 },
    { label: 'I lived legally in Germany for 6 months or more in the last 5 years (not as a tourist)', points: 1 },
    { label: 'My spouse or partner also qualifies and is applying with me', points: 1 },
  ] },
];
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
  { '@type': 'ListItem', position: 2, name: 'Germany Opportunity Card checker', item: site.url + '/tools/germany-opportunity-card-checker/' },
] };
---
<Base title={title} description={description} schema={[crumbs]}>
  <div class="wrap">
    <header class="page-head">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/countries/germany/">Germany</a><span>/</span><span>Opportunity Card checker</span></nav>
      <h1 class="display" style="max-width:15em">Germany Opportunity Card Points Checker</h1>
      <p class="lede" style="margin-top:18px;max-width:640px">The Opportunity Card (Chancenkarte) lets qualified people enter Germany and look for work for up to one year. Without full recognition of your qualification, you need six points.</p>
    </header>

    <PointsTool mode="de" questions={questions} pass={6} max={14} toolName="Germany Opportunity Card checker" />

    <div class="prose">
      <h2>How the Opportunity Card works</h2>
      <p>There are two ways to qualify. If your qualification is fully recognised in Germany, you can apply as a skilled worker without the points test. Otherwise you need to meet the basic requirements and score at least six points for recognition, experience, language, age and ties to Germany.</p>
      <ul>
        <li>The card is issued for up to one year to look for a job.</li>
        <li>You may work part-time, up to 20 hours a week, and take trial jobs of up to two weeks.</li>
        <li>You must show you can support yourself, usually through a blocked account. The required amount is set by the German authorities and revised each year.</li>
        <li>Nurses, physiotherapists and other regulated professions still need recognition (Anerkennung) before they can practise.</li>
      </ul>
      <p class="notice">This checker gives an indication only. The German mission decides each application on its documents, and rules change. It is not legal advice. Have your result checked by a consultant before you open a blocked account or pay any fee.</p>
    </div>
  </div>
</Base>
