---
// Shell for the /admin/ pages. Never indexed or cached.
import { collections } from '../lib/collections';
import type { User } from '../lib/auth';

interface Props { title: string; user?: User | null; active?: string }
const { title, user, active } = Astro.props;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} · Mount Bell admin</title>
  <link rel="icon" href="/favicon.png" />
  <style is:global>
    :root { --ink: #131c33; --ink-2: #45506a; --ink-3: #6f7890; --line: #ddd6c7; --paper: #fbf9f4; --white: #fff; --blue: #2f4599; --blue-deep: #1c2b68; --green: #3d6a22; --err: #b3321f; color-scheme: light; }
    * { box-sizing: border-box; }
    body { margin: 0; font: 16px/1.5 system-ui, -apple-system, 'Segoe UI', sans-serif; color: var(--ink); background: var(--paper); }
    a { color: var(--blue); }
    .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; padding: 12px 20px; background: var(--white); border-bottom: 1px solid var(--line); }
    .bar img { height: 34px; width: auto; display: block; }
    .bar nav { display: flex; flex-wrap: wrap; gap: 4px; flex: 1; }
    .bar nav a { padding: 6px 10px; border-radius: 6px; text-decoration: none; color: var(--ink-2); font-weight: 500; }
    .bar nav a[aria-current] { background: #e9edf8; color: var(--blue-deep); }
    .bar .who { display: flex; gap: 12px; align-items: center; font-size: 0.9rem; color: var(--ink-3); }
    main { max-width: 1040px; margin: 0 auto; padding: 28px 20px 80px; }
    h1 { font-size: 1.6rem; margin: 0 0 6px; }
    .intro { margin: 0 0 22px; color: var(--ink-2); max-width: 46em; }
    .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: start; gap: 12px; }
    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; border-radius: 8px; border: 1px solid var(--blue); background: var(--blue); color: #fff; font: inherit; font-weight: 600; text-decoration: none; cursor: pointer; }
    .btn:hover { background: var(--blue-deep); }
    .btn.ghost { background: var(--white); color: var(--blue); }
    .btn.danger { background: var(--white); color: var(--err); border-color: var(--err); }
    table { width: 100%; border-collapse: collapse; background: var(--white); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
    th, td { padding: 11px 14px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
    th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-3); background: #f6f3ec; }
    tr:last-child td { border-bottom: 0; }
    td a { font-weight: 600; }
    .pill { display: inline-block; padding: 1px 9px; border-radius: 99px; font-size: 0.82rem; background: #eee; color: var(--ink-2); }
    .pill.on { background: #e4f0da; color: var(--green); }
    .wrap-table { overflow-x: auto; }
    form.edit { display: grid; gap: 18px; max-width: 760px; }
    label { display: grid; gap: 5px; font-weight: 600; }
    label small { font-weight: 400; color: var(--ink-3); }
    input[type=text], input[type=email], input[type=password], input[type=number], input[type=datetime-local], select, textarea {
      width: 100%; padding: 10px 12px; border: 1px solid #c9c1b0; border-radius: 8px; font: inherit; font-weight: 400; background: var(--white); color: var(--ink); }
    textarea.md { font-family: ui-monospace, Menlo, monospace; font-size: 0.92rem; }
    input:focus, select:focus, textarea:focus { outline: 2px solid var(--blue); outline-offset: 1px; }
    .check { display: flex; gap: 10px; align-items: center; }
    .check input { width: 18px; height: 18px; }
    .acts { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
    .msg { padding: 12px 14px; border-radius: 8px; margin: 0 0 18px; }
    .msg.ok { background: #e4f0da; color: #2b4d17; }
    .msg.err { background: #f8e1dc; color: #7c2214; }
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
    .card { display: block; padding: 18px; background: var(--white); border: 1px solid var(--line); border-radius: 10px; text-decoration: none; color: var(--ink); }
    .card strong { display: block; font-size: 1.05rem; }
    .card span { color: var(--ink-3); font-size: 0.9rem; }
    .card b { display: block; margin-top: 8px; font-size: 1.8rem; color: var(--blue); }
    .field { display: grid; gap: 5px; }
    .field > label { display: block; }
    .field > small { color: var(--ink-3); }
    .md-tools { display: flex; flex-wrap: wrap; gap: 4px; padding: 6px; background: #f1ede4; border: 1px solid #c9c1b0; border-bottom: 0; border-radius: 8px 8px 0 0; }
    .md-tools button { padding: 6px 11px; border: 1px solid transparent; border-radius: 6px; background: var(--white); font: inherit; font-size: 0.9rem; color: var(--ink); cursor: pointer; }
    .md-tools button:hover:not(:disabled) { border-color: var(--blue); }
    .md-tools button:disabled { opacity: 0.4; cursor: default; }
    .md-tools .md-preview-btn { margin-left: auto; background: var(--blue); color: #fff; font-weight: 600; }
    .md-field textarea, .md-field .md-preview { border-radius: 0 0 8px 8px; }
    .md-preview { min-height: 320px; padding: 18px 22px; background: var(--white); border: 1px solid #c9c1b0; color: var(--ink-2); }
    .md-preview > * + * { margin-top: 14px; }
    .md-preview h2 { font-size: 1.35rem; color: var(--ink); margin-top: 28px; }
    .md-preview img { max-width: 100%; height: auto; border-radius: 10px; }
    .md-preview ul, .md-preview ol { padding-left: 1.3em; }
    .up-status { margin: 0; font-size: 0.9rem; font-weight: 500; }
    .up-status:empty { display: none; }
    .up-status[data-state=busy] { color: var(--ink-3); }
    .up-status[data-state=ok] { color: var(--green); }
    .up-status[data-state=err] { color: var(--err); }
    .photo-field { margin: 0; padding: 0; border: 0; min-width: 0; }
    .photo-field legend { font-weight: 600; padding: 0; margin-bottom: 6px; }
    .photo-row { display: flex; flex-wrap: wrap; gap: 16px; align-items: start; }
    .photo-now { width: 280px; max-width: 100%; aspect-ratio: 16 / 9; height: auto; object-fit: cover; border-radius: 8px; border: 1px solid var(--line); background: #eee; }
    .photo-acts { display: grid; gap: 8px; justify-items: start; flex: 1; min-width: 200px; }
    .photo-acts small { color: var(--ink-3); }
    .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 8px; margin-top: 14px; padding: 12px; background: var(--white); border: 1px solid var(--line); border-radius: 10px; max-height: 360px; overflow-y: auto; }
    .photo-grid[hidden] { display: none; }
    .photo-grid button { padding: 0; border: 3px solid transparent; border-radius: 8px; background: none; cursor: pointer; overflow: hidden; }
    .photo-grid button[aria-pressed=true] { border-color: var(--blue); }
    .photo-grid img { display: block; width: 100%; aspect-ratio: 16 / 11; height: auto; object-fit: cover; }
    .save-bar { position: sticky; bottom: 0; padding: 12px 0; background: linear-gradient(transparent, var(--paper) 30%); }
    @media (max-width: 640px) { th:nth-child(n+3), td:nth-child(n+3) { display: none; } }
  </style>
</head>
<body>
  {user && (
    <header class="bar">
      <a href="/admin/"><img src="/logo.png" alt="Mount Bell admin home" /></a>
      <nav>
        {collections.map((c) => <a href={`/admin/list/?c=${c.key}`} aria-current={active === c.key ? 'page' : undefined}>{c.label}</a>)}
      </nav>
      <div class="who"><span>{user.name}</span><a href="/" target="_blank" rel="noopener">View site</a><form method="post" action="/admin/logout/" style="margin:0"><button class="btn ghost" style="padding:4px 10px">Sign out</button></form></div>
    </header>
  )}
  <main><slot /></main>
</body>
</html>
